{
  "name": "@manycore/aholo-sdk-lux3d",
  "version": "1.5.0",
  "description": "Aholo Lux3D generation, part split, and task history client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manycoretech/aholo-spatial-sdk.git"
  },
  "homepage": "https://github.com/manycoretech/aholo-spatial-sdk#readme",
  "bugs": {
    "url": "https://github.com/manycoretech/aholo-spatial-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx test/new-apis.test.ts",
    "clean": "rm -rf dist",
    "generate": "openapi-typescript \"${LUX3D_OPENAPI_SPEC:?Set LUX3D_OPENAPI_SPEC to the path of lux3d openapi.yaml}\" --default-non-nullable false -o src/generated/lux3d-api.ts"
  },
  "dependencies": {
    "@manycore/aholo-sdk-core": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
